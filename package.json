{
  "name": "anticodex",
  "version": "0.1.0",
  "private": true,
  "description": "ANTICODEX — universal AI workspace: chat, code agents, MCP connectors, image/video generation, computer-use. Chat-class UI with Claude-class agents.",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:web": "npm run build --prefix web",
    "start": "node server.mjs",
    "test": "node tests/test-api.mjs && node tests/test-web.mjs",
    "test:api": "node tests/test-api.mjs",
    "package:win": "node desktop/package-win.mjs",
    "release:win": "node desktop/package-win.mjs --release"
  },
  "engines": {
    "node": ">=20"
  }
}
